<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cenário "Av. Unisinos" (versão simplificada) — SOMENTE INFRAESTRUTURA.

  Abrir no SUMO-GUI (roda sem nenhum veículo):

      sumo-gui -c av-unisinos.sumocfg

  Nenhum <route-files> é declarado de propósito: esta etapa não tem demanda de
  tráfego (sem veículos, routes, trips, flows). A janela abre mostrando a
  avenida, os dois sentidos, o divisor central, as três interseções e os três
  semáforos (tls_1, tls_2, tls_3).
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="av-unisinos.net.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="100000"/>
    </time>

</configuration>
